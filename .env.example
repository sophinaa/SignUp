# Copy to .env for local development. On your host, set these as environment
# variables instead (never commit real values).

# Required in production. Signs guest manage links, organiser sessions and
# anti-spam tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Password for the organiser view at /organiser (at least 12 characters).
# Leave empty to disable organiser access.
ORGANISER_PASSWORD=

# Public address of the site, used for link previews and calendar files.
# e.g. https://sharedlightcafe.example.org
SITE_URL=

# Folder where the SQLite database is stored. Must be on persistent storage.
DATA_DIR=./data

# Set to "production" when deployed (enables secure cookies and HSTS).
NODE_ENV=development

# Set to 1 when running behind one reverse proxy / load balancer (most hosts),
# so rate limiting sees the visitor's real IP address.
TRUST_PROXY=

PORT=3000
