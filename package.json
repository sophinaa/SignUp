{
  "name": "shared-light-cafe",
  "version": "1.0.0",
  "private": true,
  "description": "RSVP website for Shared Light Café",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "npm run build && node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "dev:hero": "vite build --watch --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
